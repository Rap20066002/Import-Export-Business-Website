DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"
JWT_SECRET="replace-with-a-strong-secret"
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:3001"

# Email — use SendGrid OR SMTP (Gmail/Outlook). Required for real RFQ/order alerts.
ADMIN_NOTIFICATION_EMAIL="sales@your-company.com"

# Option A: SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="trade@your-company.com"

# Option B: SMTP (example: Gmail app password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="trade@your-company.com"

# Optional object storage (AWS S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION="ap-south-1"
